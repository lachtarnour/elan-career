# ============================================================
# Élan — Configuration
# Copy this file to .env and fill the values you need.
# ============================================================

# ---- LLM Provider ----
# Active provider: openai | mock
LLM_PROVIDER=openai
OPENAI_API_KEY=
OPENAI_MODEL_CHEAP=gpt-5.4-mini
OPENAI_MODEL_SMART=gpt-4o
OPENAI_MODEL_EMBED=text-embedding-3-small
OPENAI_MAX_COMPLETION_TOKENS=6000
# Local exact-response cache retention. Expired entries are deleted automatically.
LLM_CACHE_TTL_DAYS=15

# ---- Embeddings Provider ----
# openai | local | mock
EMBEDDINGS_PROVIDER=openai
LOCAL_EMBEDDINGS_MODEL=paraphrase-multilingual-MiniLM-L12-v2

# ---- Database ----
DATABASE_URL=sqlite:///./data/smartapply.db

# ---- Paths ----
# Local private profile directory. Keep this path out of Git; use
# ./smartapply/profile/mock_profile as the public shape/reference.
PROFILE_DIR=./smartapply/profile/data
OUTPUT_DIR=./data/output
CACHE_DIR=./data/cache

# SerpApi (Google Jobs)
# https://serpapi.com/google-jobs-api
SERPAPI_API_KEY=
SERPAPI_GOOGLE_DOMAIN=google.com
SERPAPI_HL=en,fr
SERPAPI_GL=fr
SERPAPI_DEFAULT_LOCATION=Paris, France
# Number of paginated pages to fetch per query (10 results per page)
SERPAPI_MAX_PAGES=3
# Low-result fallback target. Keep 10 by default; use 20 with max pages >= 2.
SERPAPI_LOW_RESULT_FALLBACK_TARGET=10
# Freshness filter for Google Jobs: any, today, 3days, week, month.
# Default recommendation: week = offers from the last 7 days.
SERPAPI_DATE_POSTED=week
# Optional advanced raw filter copied from SerpApi filters[].parameters.uds.
SERPAPI_UDS=

# France Travail API (free, official)
# https://francetravail.io
FRANCETRAVAIL_CLIENT_ID=
FRANCETRAVAIL_CLIENT_SECRET=
FRANCETRAVAIL_SCOPE=api_offresdemploiv2 o2dsoffre

# LinkedIn via Apify valig/linkedin-jobs-scraper
APIFY_TOKEN=
# Apify actor defaults: F=Full-time; 2=Entry level, 3=Associate,
# 4=Mid-Senior level (used only as fallback after 2/3);
# 1/2/3=On-site/Remote/Hybrid.
LINKEDIN_CONTRACT_TYPE=F
LINKEDIN_EXPERIENCE_LEVEL=2,3,4
LINKEDIN_REMOTE=1,2,3
LINKEDIN_DATE_POSTED=week
# Maximum time to wait for one synchronous Apify actor request, in seconds.
LINKEDIN_TIMEOUT=180
# Per-query LinkedIn/Apify result limit. No global cap on combined results.
# Valid range: 1-300.
LINKEDIN_MAX_RESULTS=50

# Welcome to the Jungle (optional authenticated feed)
# See docs/sources/welcometothejungle.md for setup.
WTTJ_COOKIE=

# ---- Pipeline tuning ----
TOP_K_RANKED=25
DEDUP_TITLE_THRESHOLD=85
DEDUP_DESC_THRESHOLD=70
# Merge a secondary skill block containing fewer than the configured number
# of skills into the closest compatible block at render time only.
# Set to false to restore the previous rendering behaviour.
CV_MERGE_SPARSE_SECONDARY_SKILLS=true
CV_SECONDARY_SKILL_BLOCK_MIN_SIZE=4

# ---- Logging ----
LOG_LEVEL=INFO
