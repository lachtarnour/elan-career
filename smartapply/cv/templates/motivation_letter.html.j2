<!doctype html>
<html lang="{{ 'en' if labels.document_title == 'Motivation Letter' else 'fr' }}">
<head>
  <meta charset="utf-8">
  <title>{{ labels.document_title }} - {{ profile.identity.full_name }}</title>
  <style>
    @page {
      size: A4;
      margin: 12.5mm 13.5mm 11.5mm 13.5mm;
    }

    :root {
      --ink: #121722;
      --body: #242a36;
      --muted: #5c6678;
      --soft: #788397;
      --rule: #dde3eb;
      --rule-soft: #eef2f6;
      --rule-strong: #aeb8c8;
      --accent: #0f5f6b;
      --accent-dark: #083f49;
      --accent-2: #9a6420;
      --paper: #ffffff;
    }

    * {
      box-sizing: border-box;
    }

    body {
      margin: 0;
      color: var(--body);
      font-family: "Aptos", "Inter", "Segoe UI", Arial, Helvetica, sans-serif;
      font-size: 9.8pt;
      line-height: 1.36;
      letter-spacing: 0;
      background: var(--paper);
    }

    h1,
    h2 {
      margin: 0;
      color: var(--ink);
    }

    h1 {
      font-family: "Aptos Display", "Segoe UI", Arial, Helvetica, sans-serif;
      font-size: 20.8pt;
      line-height: 0.98;
      font-weight: 780;
    }

    .headline {
      margin: 0;
      color: var(--accent-dark);
      font-size: 9.05pt;
      line-height: 1.16;
      font-weight: 760;
      white-space: normal;
      max-width: 78mm;
    }

    header {
      margin: 0 0 16px 0;
      padding-bottom: 11px;
      border-bottom: 0.9px solid var(--rule);
    }

    .identity-line {
      display: grid;
      grid-template-columns: max-content 1px minmax(0, 78mm);
      column-gap: 8px;
      align-items: baseline;
      margin-bottom: 4px;
      min-width: 0;
      max-width: 100%;
    }

    .identity-separator {
      width: 1px;
      height: 11px;
      margin-top: 1px;
      background: linear-gradient(180deg, var(--rule-soft), var(--rule-strong), var(--rule-soft));
    }

    .contact {
      margin: 0;
      font-size: 8.6pt;
      color: var(--muted);
      line-height: 1.35;
      text-wrap: pretty;
    }

    .contact a {
      color: var(--accent-dark);
      text-decoration: none;
    }

    .contact a:hover {
      text-decoration: underline;
    }

    .contact-separator {
      color: var(--soft);
    }

    .meta {
      margin: 0 0 16px auto;
      width: 74mm;
      padding-left: 4mm;
      font-size: 8.9pt;
      line-height: 1.32;
      color: var(--body);
      border-left: 1px solid var(--rule-soft);
      padding-top: 1px;
      padding-bottom: 1px;
    }

    .meta div + div {
      margin-top: 2px;
    }

    .section-title {
      margin: 0 0 12px 0;
      padding-bottom: 3px;
      border-bottom: 0.9px solid var(--rule-soft);
      color: var(--accent-dark);
      font-size: 11.1pt;
      line-height: 1.2;
      font-weight: 660;
    }

    .subject {
      margin: 0 0 15px 0;
      font-size: 9.35pt;
      color: var(--ink);
      font-weight: 640;
    }

    .body p {
      margin: 0 0 11px 0;
      text-align: left;
      line-height: 1.39;
      text-wrap: pretty;
    }

    .signature {
      margin-top: 22px;
      color: var(--muted);
      font-size: 8.95pt;
    }
  </style>
</head>
<body>
  <header>
    <div class="identity-line">
      <h1>{{ profile.identity.full_name }}</h1>
      <span class="identity-separator" aria-hidden="true"></span>
      <p class="headline">{{ letter_headline }}</p>
    </div>
    <p class="contact">
      {% for item in contact_items -%}
      {% if item.href %}<a href="{{ item.href }}">{{ item.label }}</a>{% else %}{{ item.label }}{% endif %}{% if not loop.last %}<span class="contact-separator"> | </span>{% endif %}
      {%- endfor %}
    </p>
  </header>

  <div class="meta">
    {% if job_company %}<div>{{ job_company }}</div>{% endif %}
    <div>{{ labels.role }}{{ labels.separator }} {{ job_title }}</div>
  </div>

  <section>
    <h2 class="section-title">{{ labels.document_title }}</h2>
    <p class="subject">{{ labels.subject }}{{ labels.separator }} {{ subject }}</p>
    <div class="body">
      {% for paragraph in paragraphs %}
      <p>{{ paragraph }}</p>
      {% endfor %}
    </div>
    <p class="signature">{{ labels.signoff }}<br>{{ profile.identity.full_name }}</p>
  </section>
</body>
</html>
