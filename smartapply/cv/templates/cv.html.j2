<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <title>CV - {{ profile.identity.full_name }}</title>
  <style>
    /* Explicit local faces give the macOS PDF a genuine Medium weight. */
    @font-face {
      font-family: "CV Helvetica Neue";
      src: local("HelveticaNeue");
      font-style: normal;
      font-weight: 400;
    }

    @font-face {
      font-family: "CV Helvetica Neue";
      src: local("HelveticaNeue-Medium");
      font-style: normal;
      font-weight: 500;
    }

    @page {
      size: A4;
      margin: 10.5mm 13.5mm 9.5mm 13.5mm;
    }

    * {
      box-sizing: border-box;
      font-weight: 400;
    }

    :root {
      --ink: #121722;
      --body: #202020;
      --muted: #414141;
      --soft: #4a4a4a;
      --rule: #a8a8a8;
      --rule-soft: #d0d0d0;
      --rule-strong: #7a7a7a;
      --accent: #0f5f6b;
      --accent-dark: #083f49;
      --accent-2: #9a6420;
      --paper: #ffffff;
      --surface: #f8fafc;
      --section-content-indent: 3.5mm;
    }

    body {
      margin: 0;
      min-height: calc(297mm - 20mm);
      color: var(--body);
      background: var(--paper);
      font-family: "CV Helvetica Neue", "Helvetica Neue", "Aptos", "Inter", "Segoe UI", Arial, Helvetica, sans-serif;
      font-synthesis: none;
      font-size: var(--body-size);
      line-height: var(--line-height);
      display: flex;
      flex-direction: column;
      letter-spacing: 0;
    }

    body.cv-very-airy {
      --body-size: 10.1pt;
      --line-height: 1.48;
      --summary-line-height: 1.44;
      --section-gap: 18px;
      --section-title-gap: 8px;
      --entry-gap: 16px;
      --entry-title-gap: 7px;
      --project-gap: 7px;
      --bullet-gap: 6px;
      --section-justify: space-between;
    }

    body.cv-airy {
      --body-size: 9.75pt;
      --line-height: 1.42;
      --summary-line-height: 1.40;
      --section-gap: 15px;
      --section-title-gap: 7px;
      --entry-gap: 14px;
      --entry-title-gap: 6px;
      --project-gap: 6px;
      --bullet-gap: 5px;
      --section-justify: space-between;
    }

    body.cv-balanced {
      --body-size: 9.5pt;
      --line-height: 1.36;
      --summary-line-height: 1.36;
      --section-gap: 12px;
      --section-title-gap: 6px;
      --entry-gap: 12px;
      --entry-title-gap: 5px;
      --project-gap: 5px;
      --bullet-gap: 4px;
      --section-justify: space-between;
    }

    body.cv-compact,
    body.cv-ultra {
      --body-size: 9.5pt;
      --line-height: 1.30;
      --summary-line-height: 1.30;
      --section-gap: 9px;
      --section-title-gap: 5px;
      --entry-gap: 10px;
      --entry-title-gap: 4px;
      --project-gap: 4px;
      --bullet-gap: 3px;
      --section-justify: space-between;
    }

    body.cv-ultra {
      --body-size: 9.5pt;
      --line-height: 1.24;
      --summary-line-height: 1.24;
      --section-gap: 7px;
      --section-title-gap: 4px;
      --entry-gap: 8px;
      --entry-title-gap: 3px;
      --project-gap: 3px;
      --bullet-gap: 2px;
      --section-justify: space-between;
    }

    a {
      color: var(--accent-dark);
      text-decoration: none;
    }

    header {
      padding-top: 2px;
      /* Use the same adaptive spacing scale as the CV sections. */
      margin-bottom: var(--section-gap);
      flex-shrink: 0;
    }

    .header-grid {
      display: grid;
      grid-template-columns: minmax(0, 1fr) 58mm;
      column-gap: 8mm;
      align-items: start;
    }

    .identity-line {
      display: grid;
      grid-template-columns: max-content 1px minmax(0, 70mm);
      column-gap: 9px;
      align-items: baseline;
      min-width: 0;
      max-width: 100%;
    }

    h1 {
      margin: 0;
      color: var(--ink);
      font-size: 18pt;
      line-height: 0.95;
      letter-spacing: 0;
      white-space: nowrap;
    }

    h1,
    .section-title {
      font-weight: 500;
    }

    /* Keep all content labels visually identical, not just their weight. */
    .entry-title > strong,
    .project-row > strong,
    .skill-label {
      font-size: 9.5pt;
      font-weight: 400;
      color: #000000;
    }

    .headline {
      margin: 0;
      color: var(--accent-dark);
      font-size: 9.15pt;
      line-height: 1.23;
      max-width: 70mm;
      min-width: 0;
      overflow-wrap: anywhere;
      white-space: normal;
    }

    .identity-separator {
      width: 1px;
      height: 12px;
      margin-top: 1px;
      background: linear-gradient(180deg, var(--rule-soft), var(--rule-strong), var(--rule-soft));
    }

    .summary {
      margin: 12px 0 0 0;
      max-width: 126mm;
      color: var(--body);
      font-size: 9.5pt;
      line-height: var(--summary-line-height);
    }

    .contact {
      margin: 0;
      padding: 4px 0 4px 7mm;
      color: #000000;
      font-size: 8.75pt;
      line-height: 1.36;
      text-align: right;
    }

    .contact-item {
      display: block;
      margin-bottom: 2px;
      overflow-wrap: anywhere;
    }

    .contact a {
      color: inherit;
    }

    .sections {
      flex: 1 1 auto;
      display: flex;
      flex-direction: column;
      gap: var(--section-gap);
      justify-content: var(--section-justify);
    }

    .section {
      flex-shrink: 0;
      margin: 0;
      break-inside: avoid;
    }

    .section-title {
      display: grid;
      grid-template-columns: auto 1fr;
      align-items: center;
      gap: 11px;
      margin: 0 0 var(--section-title-gap) 0;
      color: var(--accent-dark);
      font-size: 8.55pt;
      line-height: 1;
      letter-spacing: 0;
      text-transform: uppercase;
    }

    .section-title::after {
      content: "";
      height: 0;
      border-top: 0.6pt solid var(--rule-strong);
    }

    .section > :not(.section-title) {
      margin-left: var(--section-content-indent);
    }

    .entry {
      display: grid;
      grid-template-columns: 29mm 1fr;
      column-gap: 4.5mm;
      margin-bottom: var(--entry-gap);
      break-inside: avoid;
    }

    .entry:last-child {
      margin-bottom: 0;
    }

    .entry-left {
      color: var(--soft);
      font-size: 8.4pt;
      line-height: 1.26;
      white-space: pre-line;
    }

    .entry-title {
      margin: 0 0 2px 0;
      color: var(--muted);
      font-size: 9.25pt;
      line-height: 1.30;
    }

    .experience-entry .entry-title {
      margin-bottom: var(--entry-title-gap);
    }

    .education-institution {
      font-size: var(--body-size);
      white-space: nowrap;
    }

    .entry-right {
      min-width: 0;
    }

    .bullets {
      margin: 0;
      padding: 0;
      list-style: none;
    }

    .bullets li {
      position: relative;
      margin: 0 0 var(--bullet-gap) 0;
      padding-left: 10px;
    }

    .bullets li:last-child {
      margin-bottom: 0;
    }

    .bullets li::before {
      content: "";
      position: absolute;
      left: 1px;
      top: 0.63em;
      width: 3.4px;
      height: 3.4px;
      border-radius: 0.8px;
      background: var(--accent-2);
      transform: rotate(45deg);
    }

    .skills {
      break-inside: avoid;
    }

    .skill-row {
      margin: 0 0 var(--entry-gap) 0;
      break-inside: avoid;
    }

    .skill-row:last-child {
      margin-bottom: 0;
    }

    .skill-list {
      color: var(--body);
    }

    .project-row,
    .certificates p {
      margin: 0 0 var(--project-gap) 0;
    }

    .project-row:last-child,
    .certificates p:last-child {
      margin-bottom: 0;
    }

    .language-row {
      display: flex;
      flex-wrap: nowrap;
      align-items: baseline;
      gap: 5px;
      margin: 0;
      white-space: nowrap;
    }

    .language-item {
      display: inline-flex;
      align-items: baseline;
      gap: 3px;
    }

    .language-name {
      color: var(--ink);
    }

    .language-level {
      color: var(--muted);
    }

    .language-separator {
      color: var(--rule-strong);
    }

    .project-row {
      position: relative;
      padding-left: 10px;
      break-inside: avoid;
    }

    .project-row::before {
      content: "";
      position: absolute;
      left: 1px;
      top: 0.65em;
      width: 3.5px;
      height: 3.5px;
      border-radius: 0.8px;
      background: var(--accent-2);
      transform: rotate(45deg);
    }

    .certificates strong {
      color: var(--ink);
    }

    .name-link {
      color: inherit;
      font: inherit;
    }

    .inline-link {
      display: inline-block;
      width: 0.9em;
      height: 0.9em;
      margin-left: 4px;
      color: var(--accent-dark);
      position: relative;
      text-decoration: none;
      vertical-align: 0.02em;
    }

    .inline-link::before,
    .inline-link::after {
      content: "";
      position: absolute;
      width: 0.5em;
      height: 0.27em;
      border: 1.15px solid currentColor;
      border-radius: 0.24em;
      transform: rotate(-35deg);
    }

    .inline-link::before {
      left: 0.07em;
      top: 0.37em;
    }

    .inline-link::after {
      left: 0.35em;
      top: 0.2em;
    }

    .muted {
      color: var(--muted);
    }
  </style>
</head>
<body class="{{ layout_class }}">
  <header>
    <div class="header-grid">
      <div>
        <div class="identity-line">
          <h1>{{ profile.identity.full_name }}</h1>
        {% if adapted.cv_title %}
          <span class="identity-separator"></span>
          <p class="headline">{{ adapted.cv_title }}</p>
        {% endif %}
        </div>
        <p class="summary">{{ adapted.professional_summary }}</p>
      </div>
      <p class="contact">
        {% for item in contact_items -%}
        <span class="contact-item">{% if item.href %}<a href="{{ item.href }}">{{ item.label }}</a>{% else %}{{ item.label }}{% endif %}</span>
        {%- endfor %}
      </p>
    </div>
  </header>

  <div class="sections">
  {% if experiences %}
  <section class="section">
    <h2 class="section-title">Professional Experience</h2>
    {% for item in experiences %}
    <div class="entry experience-entry">
      <div class="entry-left">{{ item.source.start_date }} &ndash; {{ item.source.end_date }}
{{ item.source.location }}</div>
      <div class="entry-right">
        <div class="entry-title"><strong>{{ item.source.title }}</strong>, {% if item.source.url %}<a class="name-link" href="{{ item.source.url }}">{{ item.source.company }}</a>{% else %}{{ item.source.company }}{% endif %}</div>
        <ul class="bullets">
          {% for bullet in item.bullets %}
          <li>{{ bullet.html }}</li>
          {% endfor %}
        </ul>
      </div>
    </div>
    {% endfor %}
  </section>
  {% endif %}

  {% if education %}
  <section class="section">
    <h2 class="section-title">Education</h2>
    {% for degree in education %}
    <div class="entry">
      <div class="entry-left">{{ degree.start_date | default(degree.start_year, true) }} &ndash; {{ degree.end_date | default(degree.end_year, true) }}</div>
      <div class="entry-right">
        <div class="entry-title">
          <strong>{% if degree.url %}<a class="name-link" href="{{ degree.url }}">{% endif %}{{ degree.title }}{% if degree.field %} &ndash; {{ degree.field }}{% endif %}{% if degree.url %}</a>{% endif %}</strong><span class="education-separator"> · </span><span class="education-institution">{{ degree.institution }}</span>
        </div>
      </div>
    </div>
    {% endfor %}
  </section>
  {% endif %}

  {% if skill_categories %}
  <section class="section skills">
    <h2 class="section-title">Skills</h2>
    {% for category in skill_categories %}
    <div class="skill-row">
      <strong class="skill-label">{{ category.name }}:</strong>
      <span class="skill-list">{{ category.skills | join(' · ') }}</span>
    </div>
    {% endfor %}
  </section>
  {% endif %}

  {% if projects %}
  <section class="section projects">
    <h2 class="section-title">Projects</h2>
    {% for project in projects %}
    <p class="project-row">
      <strong>{% if project.url %}<a class="name-link" href="{{ project.url }}">{{ project.name }}</a>{% else %}{{ project.name }}{% endif %}</strong>
      &nbsp;{{ project.description }}
    </p>
    {% endfor %}
  </section>
  {% endif %}

  {% if languages %}
  <section class="section languages">
    <h2 class="section-title">Languages</h2>
    <p class="language-row">
      {% for language in languages %}
      <span class="language-item"><span class="language-name">{{ language.name }}</span><span class="language-level">{{ language.level }}</span></span>{% if not loop.last %}<span class="language-separator">|</span>{% endif %}
      {% endfor %}
    </p>
  </section>
  {% endif %}

  {% if certificates %}
  <section class="section certificates">
    <h2 class="section-title">Certificates</h2>
    {% for certificate in certificates %}
    <p><strong>{% if certificate.url %}<a class="name-link" href="{{ certificate.url }}">{{ certificate.name }}</a>{% else %}{{ certificate.name }}{% endif %}</strong> &mdash; {{ certificate.issuer }}{% if certificate.description %} &mdash; <span class="muted">{{ certificate.description }}</span>{% endif %}</p>
    {% endfor %}
  </section>
  {% endif %}
  </div>
</body>
</html>
